# Data and artifacts are reproducible from the pipeline; never commit them.
# Leading slash is load-bearing: a bare `data/` also matches src/apexstrategy/data/,
# and a bare `models/` would silently untrack src/apexstrategy/models/ in Phase 5.
/data/
/models/
*.joblib
*.parquet
*.ff1pkl

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# web
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/.vercel
